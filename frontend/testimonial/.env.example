# Base URL of the backend API the browser calls.
# Backend runs on :8080 by default (see backend/testimonial/src/main/resources/application.yaml).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Cloudflare Turnstile public site key (PRD 4.5 abuse protection).
# The matching secret key belongs in the backend environment, not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
