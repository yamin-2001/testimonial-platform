# ---- PostgreSQL (docker-compose) ----
POSTGRES_DB=testimonial
POSTGRES_USER=testimonial
POSTGRES_PASSWORD=testimonial
POSTGRES_PORT=5432

# ---- Backend ----
# Base JDBC URL for local development.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/testimonial
SPRING_DATASOURCE_USERNAME=testimonial
SPRING_DATASOURCE_PASSWORD=testimonial

# Public base URL of the backend API (used to build links in emails).
APP_PUBLIC_BASE_URL=http://localhost:8080

# Google OAuth2 (PRD 4.1). Create a Web application credential in Google Cloud Console.
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (PRD 4.9). Test-mode keys from the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret for the webhook endpoint (Stripe -> Developers -> Webhooks).
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile (PRD 4.5 abuse protection).
TURNSTILE_SECRET_KEY=
# Public site key, safe to expose to the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Mail (PRD 4.1 verification + reset emails).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com

# ---- Frontend ----
# Base URL of the backend API the browser calls.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
